[gd_resource type="Resource" script_class="DialogueData" format=3 uid="uid://cldyb3t74akg4"]

[ext_resource type="Script" uid="uid://tp6qdjosqu15" path="res://scenes/dialogue/DialogueLineData.gd" id="1_line"]
[ext_resource type="Script" uid="uid://knobenf0qolu" path="res://scenes/dialogue/DialogueData.gd" id="2_data"]
[ext_resource type="Texture2D" uid="uid://3y57u8pc77us" path="res://assets/dialogue/portraits/grunt_portrait.png" id="3_grunt"]
[ext_resource type="Texture2D" uid="uid://d0e37vykmdhib" path="res://assets/dialogue/portraits/eve_portrait.png" id="4_eve"]
[ext_resource type="AudioStream" uid="uid://i2ywhi72rlji" path="res://assets/audio/grunt_shout_eve.wav" id="5_shout"]

[sub_resource type="Resource" id="Resource_call00"]
script = ExtResource("1_line")
speaker = "??"
text = "Eve! A Chave-Mestra caiu. O setor de Acesso fechou as portas."
portrait = ExtResource("3_grunt")
intro_sound = ExtResource("5_shout")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_call01"]
script = ExtResource("1_line")
speaker = "E.V.E"
text = "Eu vi. Trocaram as senhas vazadas antes que ela terminasse o trabalho."
portrait = ExtResource("4_eve")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_call02"]
script = ExtResource("1_line")
speaker = "??"
text = "Agora cada conta tem a sua própria chave. E algumas ainda pedem um código que chega no celular."
portrait = ExtResource("3_grunt")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_call03"]
script = ExtResource("1_line")
speaker = "E.V.E"
text = "Então chega de forçar portas."
portrait = ExtResource("4_eve")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_call04"]
script = ExtResource("1_line")
speaker = "??"
text = "Vamos recuar?"
portrait = ExtResource("3_grunt")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_call05"]
script = ExtResource("1_line")
speaker = "E.V.E"
text = "Vamos oferecer. Programas gratuitos, extensões úteis, vídeos liberados com um clique."
portrait = ExtResource("4_eve")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_call06"]
script = ExtResource("1_line")
speaker = "E.V.E"
text = "Ninguém desconfia de um presente. Eles mesmos vão abrir a porta e ainda agradecer."
portrait = ExtResource("4_eve")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_call07"]
script = ExtResource("1_line")
speaker = "E.V.E"
text = "Vá para o setor de Downloads. Coloque um extra em cada instalador."
portrait = ExtResource("4_eve")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_call08"]
script = ExtResource("1_line")
speaker = "??"
text = "Entendido. Encerrando o canal."
portrait = ExtResource("3_grunt")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[resource]
script = ExtResource("2_data")
id = "call_after_password"
