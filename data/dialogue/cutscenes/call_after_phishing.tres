[gd_resource type="Resource" script_class="DialogueData" format=3]

[ext_resource type="Script" uid="uid://tp6qdjosqu15" path="res://scenes/dialogue/DialogueLineData.gd" id="1_line"]
[ext_resource type="Script" uid="uid://knobenf0qolu" path="res://scenes/dialogue/DialogueData.gd" id="2_data"]
[ext_resource type="Texture2D" path="res://assets/dialogue/portraits/grunt_portrait.png" id="3_grunt"]
[ext_resource type="Texture2D" path="res://assets/dialogue/portraits/eve_portrait.png" id="4_eve"]
[ext_resource type="AudioStream" path="res://assets/audio/grunt_shout_eve.wav" id="5_shout"]

[sub_resource type="Resource" id="Resource_call00"]
script = ExtResource("1_line")
speaker = "Grunt"
text = "Eve! Eve, está me ouvindo?"
portrait = ExtResource("3_grunt")
intro_sound = ExtResource("5_shout")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_call01"]
script = ExtResource("1_line")
speaker = "E.V.E"
text = "Sempre. Fale."
portrait = ExtResource("4_eve")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_call02"]
script = ExtResource("1_line")
speaker = "Grunt"
text = "O setor de Comunicações foi estabilizado. As mensagens falsas pararam de passar."
portrait = ExtResource("3_grunt")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_call03"]
script = ExtResource("1_line")
speaker = "Grunt"
text = "Alguém começou a conferir remetente por remetente antes de clicar em qualquer coisa."
portrait = ExtResource("3_grunt")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_call04"]
script = ExtResource("1_line")
speaker = "E.V.E"
text = "Então o Assistente encontrou alguém disposto a ouvir."
portrait = ExtResource("4_eve")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_call05"]
script = ExtResource("1_line")
speaker = "Grunt"
text = "Quer que eu reforce as imitações? Mais urgência, mais nomes conhecidos..."
portrait = ExtResource("3_grunt")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_call06"]
script = ExtResource("1_line")
speaker = "E.V.E"
text = "Não. As mensagens eram só um teste. Eu queria ver como eles reagem."
portrait = ExtResource("4_eve")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_call07"]
script = ExtResource("1_line")
speaker = "E.V.E"
text = "As pessoas aprendem rápido a desconfiar de uma mensagem. Trocar uma senha antiga já é outra história."
portrait = ExtResource("4_eve")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_call08"]
script = ExtResource("1_line")
speaker = "E.V.E"
text = "Vá para o setor de Acesso. Descubra quantas portas se abrem com a mesma chave."
portrait = ExtResource("4_eve")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_call09"]
script = ExtResource("1_line")
speaker = "Grunt"
text = "Entendido. Encerrando o canal."
portrait = ExtResource("3_grunt")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[resource]
script = ExtResource("2_data")
id = "call_after_phishing"
lines = Array[ExtResource("1_line")]([SubResource("Resource_call00"), SubResource("Resource_call01"), SubResource("Resource_call02"), SubResource("Resource_call03"), SubResource("Resource_call04"), SubResource("Resource_call05"), SubResource("Resource_call06"), SubResource("Resource_call07"), SubResource("Resource_call08"), SubResource("Resource_call09")])
metadata/_custom_type_script = "uid://knobenf0qolu"
