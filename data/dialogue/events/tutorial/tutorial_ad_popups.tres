[sub_resource type="Resource" id="Line_00"]
script = ExtResource("1_line")
speaker = "Assistente"
text = "O navegador foi sequestrado. A partir de agora, janelas de anúncio vão aparecer por cima da sua mesa."
portrait = ExtResource("2_portrait")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Line_01"]
script = ExtResource("1_line")
speaker = "Assistente"
text = "Feche cada uma pelo X. Clicar no botão do anúncio só abre mais janelas."
portrait = ExtResource("2_portrait")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Line_02"]
script = ExtResource("1_line")
speaker = "Assistente"
text = "Enquanto essa brecha estiver aberta, os anúncios voltam. Revisar Extensões e o Antivírus Atualizado fecham a brecha."
portrait = ExtResource("2_portrait")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[resource]
script = ExtResource("3_data")
id = "tutorial_ad_popups"
lines = Array[ExtResource("1_line")]([SubResource("Line_00"), SubResource("Line_01"), SubResource("Line_02")])
metadata/_custom_type_script = "uid://knobenf0qolu"
