[sub_resource type="Resource" id="Resource_6xyo5"]
script = ExtResource("1_j2mbj")
speaker = "Assistente"
text = "Detectei uma alteração persistente na Rede. Essa escolha abriu uma brecha de segurança."
portrait = ExtResource("2_h2s7t")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_84ihb"]
script = ExtResource("1_j2mbj")
speaker = "Assistente"
text = "Enquanto permanecer ativa, essa brecha poderá prejudicar suas próximas ações e ser explorada por futuras ameaças."
portrait = ExtResource("2_h2s7t")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_5pmo0"]
script = ExtResource("1_j2mbj")
speaker = "Assistente"
text = "Observe o indicador de brechas abertas. Passe o mouse sobre ele para consultar a causa e os efeitos da brecha."
portrait = ExtResource("2_h2s7t")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

