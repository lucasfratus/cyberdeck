[ext_resource type="Script" uid="uid://knobenf0qolu" path="res://scenes/dialogue/DialogueData.gd" id="2_ebp6r"]
[ext_resource type="Texture2D" path="res://assets/icons/ui/email.png" id="illus_1"]
[ext_resource type="Texture2D" path="res://assets/logo/carta_logo.png" id="illus_2"]
[ext_resource type="Texture2D" path="res://assets/icons/breaches/breach.png" id="illus_3"]
[ext_resource type="Texture2D" path="res://assets/icons/ui/encyclopedia.png" id="illus_4"]
[ext_resource type="Texture2D" path="res://assets/icons/ui/help.png" id="illus_5"]

[sub_resource type="Resource" id="Resource_20mwt"]
script = ExtResource("1_hfven")
speaker = "Assistente"
text = "Finalmente, um sinal estável. Eu sou o Assistente, uma inteligência de orientação vinculada ao núcleo da Rede."
portrait = ExtResource("2_20mwt")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_pkm8g"]
script = ExtResource("1_hfven")
speaker = "Assistente"
text = "Este sistema costumava conectar pessoas, informações e serviços. Agora, algumas regiões estão sendo afetadas por anomalias que imitam comunicações legítimas e exploram comportamentos inseguros."
portrait = ExtResource("2_20mwt")
illustration = ExtResource("illus_1")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_ap0rh"]
script = ExtResource("1_hfven")
speaker = "Assistente"
text = "A sua função será analisar cada situação e escolher práticas capazes de estabilizar os setores comprometidos."
portrait = ExtResource("2_20mwt")
illustration = ExtResource("illus_2")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_ebp6r"]
script = ExtResource("1_hfven")
speaker = "Assistente"
text = "Mas tenha cuidado: algumas decisões podem criar brechas. E aquilo que permanece aberto em um setor pode voltar a causar problemas mais adiante."
portrait = ExtResource("2_20mwt")
illustration = ExtResource("illus_3")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_enc01"]
script = ExtResource("1_hfven")
speaker = "Assistente"
text = "Tudo o que descobrirmos sobre as ameaças fica registrado na Enciclopédia. Lá você entende como cada ameaça age, encontra materiais de referência e vê quais práticas protegem e quais abrem brechas."
portrait = ExtResource("2_20mwt")
illustration = ExtResource("illus_4")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_enc02"]
script = ExtResource("1_hfven")
speaker = "Assistente"
text = "Se tiver dúvidas no meio de uma missão, use os ícones no canto superior direito da tela ou pressione Esc. Por eles você chega à Enciclopédia e às regras em Como jogar."
portrait = ExtResource("2_20mwt")
illustration = ExtResource("illus_5")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_ual65"]
script = ExtResource("1_hfven")
speaker = "Assistente"
text = "Eu acompanharei sua jornada e ajudarei a interpretar os sinais da Rede. Quando estiver pronto, iniciaremos!"
portrait = ExtResource("2_20mwt")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[resource]
script = ExtResource("2_ebp6r")
id = "game_intro"
lines = Array[ExtResource("1_hfven")]([SubResource("Resource_20mwt"), SubResource("Resource_pkm8g"), SubResource("Resource_ap0rh"), SubResource("Resource_ebp6r"), SubResource("Resource_enc01"), SubResource("Resource_enc02"), SubResource("Resource_ual65")])
metadata/_custom_type_script = "uid://knobenf0qolu"
