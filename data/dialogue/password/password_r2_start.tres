text = "Se a senha vazada abrir outras contas, o estrago se espalha. Cada conta precisa da sua própria chave, e de uma segunda verificação."
portrait = ExtResource("2_portrait")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[resource]
