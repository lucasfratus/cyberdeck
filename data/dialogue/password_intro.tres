[sub_resource type="Resource" id="Line_00"]
script = ExtResource("1_line")
speaker = "Assistente"
text = "Conexão estabelecida com o setor de Acesso. É aqui que a Rede confere quem pode entrar em cada conta."
portrait = ExtResource("2_portrait")
illustration = ExtResource("illus_1")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Line_01"]
script = ExtResource("1_line")
speaker = "Assistente"
text = "Alguma coisa passou pelo setor de Comunicações antes de nós e veio direto para cá. Os registros mostram a mesma tentativa de login repetida em centenas de contas."
portrait = ExtResource("2_portrait")
illustration = ExtResource("illus_2")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Line_02"]
script = ExtResource("1_line")
speaker = "Assistente"
text = "Quem está por trás disso não quer adivinhar senhas. Quer as que já vazaram, e aposta que as pessoas usam a mesma senha em todo lugar."
portrait = ExtResource("2_portrait")
illustration = ExtResource("illus_3")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Line_03"]
script = ExtResource("1_line")
speaker = "Assistente"
text = "Algumas práticas deste setor parecem cômodas, como uma senha fácil de lembrar. Elas deixam portas destrancadas para depois."
portrait = ExtResource("2_portrait")
illustration = ExtResource("illus_4")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Line_04"]
script = ExtResource("1_line")
speaker = "Assistente"
text = "Vamos fechar essas portas uma por uma."
portrait = ExtResource("2_portrait")
illustration = ExtResource("illus_5")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[resource]
script = ExtResource("3_data")
id = "password_intro"
lines = Array[ExtResource("1_line")]([SubResource("Line_00"), SubResource("Line_01"), SubResource("Line_02"), SubResource("Line_03"), SubResource("Line_04")])
metadata/_custom_type_script = "uid://knobenf0qolu"
