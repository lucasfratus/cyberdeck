[gd_resource type="Resource" script_class="DialogueData" format=3 uid="uid://1id0x8qdi07x"]

[ext_resource type="Script" uid="uid://tp6qdjosqu15" path="res://scenes/dialogue/DialogueLineData.gd" id="1_axjjj"]
[ext_resource type="Texture2D" uid="uid://bqcs830gpjh7r" path="res://assets/dialogue/assistant_portrait.png" id="2_4ucfp"]
[ext_resource type="Script" uid="uid://knobenf0qolu" path="res://scenes/dialogue/DialogueData.gd" id="2_q8emf"]

[sub_resource type="Resource" id="Resource_4ucfp"]
script = ExtResource("1_axjjj")
speaker = "Assistente"
text = "Conexão estabelecida. Estamos entrando no primeiro setor, o de Comunicações."
portrait = ExtResource("2_4ucfp")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_mir3d"]
script = ExtResource("1_axjjj")
speaker = "Assistente"
text = "Há algo estranho aqui...  As mensagens continuam circulando, mas algumas delas não pertencem a quem afirmam pertencer."
portrait = ExtResource("2_4ucfp")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_fse82"]
script = ExtResource("1_axjjj")
speaker = "Assistente"
text = "As anomalias aprenderam a imitar nomes, endereços e até o modo como pessoas conhecidas escrevem. Elas tentam despertar urgência, curiosidade ou medo antes que alguém perceba a falsificação."
portrait = ExtResource("2_4ucfp")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_q8emf"]
script = ExtResource("1_axjjj")
speaker = "Assistente"
text = "Fora daqui, essa técnica é conhecida como phishing. Dentro da Rede, ela se manifesta como uma sequência de sinais falsos misturados às comunicações legítimas."
portrait = ExtResource("2_4ucfp")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_r1np4"]
script = ExtResource("1_axjjj")
speaker = "Assistente"
text = "Analise as práticas disponíveis. Precisamos separar os sinais confiáveis das imitações antes que novas brechas sejam abertas."
portrait = ExtResource("2_4ucfp")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[resource]
script = ExtResource("2_q8emf")
id = "phishing_intro"
lines = Array[ExtResource("1_axjjj")]([SubResource("Resource_4ucfp"), SubResource("Resource_mir3d"), SubResource("Resource_fse82"), SubResource("Resource_q8emf"), SubResource("Resource_r1np4")])
metadata/_custom_type_script = "uid://knobenf0qolu"
