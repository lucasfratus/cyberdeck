metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_kkxhq"]
script = ExtResource("1_p51cr")
speaker = "Assistente"
text = "As anomalias exploraram decisões tomadas antes que a origem das mensagens fosse verificada. Na próxima tentativa, observe quais práticas ajudam a confirmar remetentes, links e solicitações incomuns."
portrait = ExtResource("2_igiru")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_8s00f"]
script = ExtResource("1_p51cr")
