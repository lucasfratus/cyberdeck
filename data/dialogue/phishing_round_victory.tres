[sub_resource type="Resource" id="Resource_3sfmh"]
script = ExtResource("1_lsrhy")
speaker = "Assistente"
text = "Boa! O sinal falso foi isolado. A conexão deste setor voltou a apresentar níveis seguros de integridade."
portrait = ExtResource("2_3sfmh")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_lsrhy"]
script = ExtResource("1_lsrhy")
speaker = "Assistente"
text = "Mensagens de phishing costumam parecer legítimas porque reproduzem nomes, identidades visuais e situações familiares. Verificar o remetente, os links e o contexto da mensagem reduz a chance de seguir uma instrução enganosa."
portrait = ExtResource("2_3sfmh")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[sub_resource type="Resource" id="Resource_v362p"]
script = ExtResource("1_lsrhy")
speaker = "Assistente"
text = "A conexão está estável por enquanto. Mas as anomalias já começaram a se espalhar para outros setores."
portrait = ExtResource("2_3sfmh")
metadata/_custom_type_script = "uid://tp6qdjosqu15"

[resource]
script = ExtResource("2_v362p")
id = "phishing_round_victory"
