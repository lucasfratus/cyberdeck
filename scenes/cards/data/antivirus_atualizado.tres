[resource]
script = ExtResource("1_script")
id = &"antivirus_atualizado"
title = "Antivírus Atualizado"
description = "Um antivírus atualizado detecta e remove programas maliciosos já instalados."
educational_description = "Programas antivírus identificam ameaças comparando arquivos e comportamentos com bases de assinaturas que são atualizadas continuamente. Por isso um antivírus desatualizado reconhece apenas ameaças antigas. Manter a atualização automática ativa e executar verificações periódicas permite detectar e remover programas maliciosos que já tenham sido instalados no dispositivo."
illustration = ExtResource("1_0ahpe")
category_icon = ExtResource("1_g42ut")
category = 6
protection = 40
closes_breach_ids = Array[String](["dispositivo_comprometido"])
