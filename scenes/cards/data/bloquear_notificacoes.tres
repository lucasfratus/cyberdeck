[resource]
script = ExtResource("2_script")
id = &"bloquear_notificacoes"
title = "Bloquear Notificações"
description = "Recuse os pedidos de sites para enviar notificações."
educational_description = "Sites maliciosos pedem permissão para enviar notificações e depois usam esse canal para mostrar anúncios e alertas falsos, mesmo com o site fechado. Permita notificações só de sites que você usa e conhece. Permissões já dadas podem ser removidas nas configurações do navegador."
