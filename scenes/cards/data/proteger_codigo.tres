[resource]
script = ExtResource("2_script")
id = &"proteger_codigo"
title = "Não Repassar o Código"
description = "Ninguém legítimo pede o código de verificação."
educational_description = "O código que chega por SMS, e-mail ou aplicativo é a segunda etapa da verificação. Golpistas que já têm a senha ligam ou mandam mensagens fingindo ser do suporte para conseguir esse código. Bancos e serviços não pedem o código por telefone ou mensagem."
illustration = ExtResource("3_illus")
category_icon = ExtResource("1_icon")
protection = 25
vulnerability = 1.5
